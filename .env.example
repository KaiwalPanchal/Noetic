# ==========================================
# Noetic Environment Configuration
# ==========================================
# Copy this file to .env and fill in your credentials.
# Secrets in .env are strictly git-ignored and never committed.

# ------------------------------------------
# Add-on Modules: Web Clipper (AgentClip)
# ------------------------------------------
# MongoDB Atlas Connection URI for clip storage and vector search:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=agent_knowledge

# Clipper Ingress Webhook Settings (for Obsidian Clipper / browser extensions):
CLIPPER_WEBHOOK_HOST=127.0.0.1
CLIPPER_WEBHOOK_PORT=8765
CLIPPER_BEARER_TOKEN=your_secure_bearer_token_here

# ------------------------------------------
# Embedding & LLM API Keys (Optional)
# ------------------------------------------
# For Atlas Vector search embeddings (or use local Ollama):
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
