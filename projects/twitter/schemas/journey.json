{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "journey",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "built": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "broke": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string"
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tweets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "harness_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anything you could not do, or assumptions you were forced to make. Empty list if none."
    }
  },
  "required": [
    "title",
    "slug",
    "built",
    "broke",
    "decision",
    "proof",
    "tweets",
    "harness_notes"
  ],
  "additionalProperties": false
}
