{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "curation",
  "type": "object",
  "properties": {
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "interest": {
            "type": "string"
          },
          "thesis": {
            "type": "string"
          },
          "why_non_obvious": {
            "type": "string"
          },
          "hooks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "style": {
                  "type": "string",
                  "enum": [
                    "contrarian",
                    "story",
                    "practitioner",
                    "question",
                    "list"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "style",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "talking_points": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3
          },
          "source_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "slug",
          "interest",
          "thesis",
          "why_non_obvious",
          "hooks",
          "talking_points",
          "source_notes"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "idea": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "idea",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "harness_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anything you could not do, or assumptions you were forced to make. Empty list if none."
    }
  },
  "required": [
    "packages",
    "rejected",
    "harness_notes"
  ],
  "additionalProperties": false
}
