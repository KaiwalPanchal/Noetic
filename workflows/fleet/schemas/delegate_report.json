{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "delegate_report",
  "type": "object",
  "properties": {
    "summary": {"type": "string"},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "done": {"type": "boolean", "description": "true only if the task is fully complete"},
    "harness_notes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Anything you could not do, or assumptions you were forced to make. Empty list if none."
    }
  },
  "required": ["summary", "files_changed", "done", "harness_notes"],
  "additionalProperties": false
}
