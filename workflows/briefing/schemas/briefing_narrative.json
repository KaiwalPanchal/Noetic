{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "briefing_narrative",
  "type": "object",
  "properties": {
    "headline": {"type": "string"},
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project": {"type": "string"},
          "action": {"type": "string"},
          "blocked_by": {"type": "string"}
        },
        "required": ["project", "action", "blocked_by"],
        "additionalProperties": false
      }
    },
    "gate_violations": {"type": "array", "items": {"type": "string"}},
    "stale_flags": {"type": "array", "items": {"type": "string"}},
    "check_in": {"type": "array", "items": {"type": "string"}},
    "harness_notes": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["headline", "next_actions", "gate_violations", "stale_flags", "check_in", "harness_notes"],
  "additionalProperties": false
}
