{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "framework",
  "type": "object",
  "properties": {
    "framework_name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "core_idea": {
      "type": "string"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "explanation"
        ],
        "additionalProperties": false
      },
      "minItems": 2
    },
    "mental_moves": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "when_to_apply": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "code",
        "project"
      ],
      "additionalProperties": false
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "genealogy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "linked_interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "book",
            "url",
            "thread",
            "notes",
            "other"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "author",
        "kind",
        "url"
      ],
      "additionalProperties": false
    },
    "provenance_note": {
      "type": "string"
    },
    "harness_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anything you could not do, or assumptions you were forced to make. Empty list if none."
    }
  },
  "required": [
    "framework_name",
    "slug",
    "core_idea",
    "principles",
    "mental_moves",
    "when_to_apply",
    "anti_patterns",
    "genealogy",
    "linked_interests",
    "source",
    "provenance_note",
    "harness_notes"
  ],
  "additionalProperties": false
}
